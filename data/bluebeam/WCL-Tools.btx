    <!-- =============================== -->
    <!--  Polyline – Combined RET + WOT   -->
    <!-- =============================== -->
    <Tool Name="RET 8 _ WOT 6" Type="Polyline">
      <Properties>
        <Property Name="Subject" Value="Retaining Wall" />
        <Property Name="Label" Value="RET 8 _ WOT 6" />
        <Property Name="Color" Value="#FF00FF" />
